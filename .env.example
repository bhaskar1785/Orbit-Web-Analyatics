# Firebase web app config (Project settings -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The site namespace events are stored under in Firestore:
# sites/{VITE_ANALYTICS_SITE_ID}/...
VITE_ANALYTICS_SITE_ID=my-site

# HTTPS URL of the deployed orbit ingest Cloud Function.
# Used by the demo page; your sites pass it with data-endpoint in the snippet.
VITE_INGEST_URL=https://us-central1-YOUR_PROJECT.cloudfunctions.net/omberIngest
